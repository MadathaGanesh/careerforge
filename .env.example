# Copy to .env; do not commit secrets.
DB_URL=jdbc:postgresql://postgres:5432/careerforge
DB_USER=careerforge
DB_PASSWORD=change_me_local_only
# For Compose, place the generated Base64 value here. See README for direct Maven and IDE runs.
JWT_SECRET=
# Optional direct-backend setting. Set it in the terminal or IDE to the full path to pdflatex.
# LATEX_COMMAND=
# Optional direct-backend override for the standard PDF export font.
# PDF_FONT_PATH=
GOOGLE_CLIENT_ID=
# Enables online salary research through SerpApi. Keep this key on the backend.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_ORIGIN=http://localhost:5173
DEV_AUTH_ENABLED=false
COOKIE_SECURE=false
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@localhost

# Optional for R3 subscriptions. Do not set live keys until reviewed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=


# Optional private object storage for production Compose or a direct backend run.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_PREFIX=careerforge/
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false

# Production and staging use compose.production.yml.
DEPLOYMENT_PROFILE=production
OPERATIONS_JMX_ENABLED=false
NOTIFICATION_ZONE=Asia/Kolkata
NOTIFICATION_POLL_MS=60000
STRIPE_RECONCILE_MS=3600000
# Set SMTP credentials along with a production MAIL_HOST, MAIL_PORT and MAIL_FROM.
MAIL_USERNAME=
MAIL_PASSWORD=
