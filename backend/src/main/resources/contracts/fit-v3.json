{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubricVersion",
    "mode",
    "scoreKind",
    "alignmentScore",
    "requirements",
    "categoryBreakdown",
    "excludedCategories",
    "disclaimer"
  ],
  "properties": {
    "rubricVersion": {
      "type": "string",
      "enum": [
        "fit-v3"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "LOCAL_HEURISTIC"
      ]
    },
    "scoreKind": {
      "type": "string",
      "enum": [
        "HEURISTIC_ESTIMATE"
      ]
    },
    "alignmentScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "label",
          "priority",
          "category",
          "status",
          "evidence",
          "rationale"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "MANDATORY",
              "PREFERRED"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "MANDATORY",
              "EXPERIENCE",
              "RESPONSIBILITIES",
              "PREFERRED",
              "EDUCATION"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "DEMONSTRATED",
              "PARTIAL",
              "UNVERIFIED",
              "MISSING",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourcePath",
                "start",
                "end",
                "excerpt"
              ],
              "properties": {
                "sourcePath": {
                  "type": "string",
                  "enum": [
                    "/contentText"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 1000,
                  "minLength": 1
                }
              }
            },
            "maxItems": 30
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        }
      },
      "maxItems": 351
    },
    "categoryBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "weight",
          "score"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "MANDATORY",
              "EXPERIENCE",
              "RESPONSIBILITIES",
              "PREFERRED",
              "EDUCATION"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "maxItems": 5
    },
    "excludedCategories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MANDATORY",
          "EXPERIENCE",
          "RESPONSIBILITIES",
          "PREFERRED",
          "EDUCATION"
        ]
      },
      "maxItems": 5
    },
    "disclaimer": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    }
  }
}
